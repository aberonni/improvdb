{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "automerge": true,
  "automergeType": "pr",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    },
    {
      "matchPackageNames": ["tailwindcss"],
      "allowedVersions": "<4"
    },
    {
      "matchPackageNames": ["prisma", "@prisma/client"],
      "allowedVersions": "<7"
    },
    {
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    },
    {
      "matchPackageNames": ["nodemailer"],
      "allowedVersions": "<8"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Version is pinned to the Playwright Docker image tag in CI and docker-compose.e2e.yml",
      "matchPackageNames": ["@playwright/test"],
      "enabled": false
    }
  ]
}
