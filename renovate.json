{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "automerge": true,
  "automergeType": "pr",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    },
    {
      "matchPackageNames": ["tailwindcss"],
      "allowedVersions": "<4"
    },
    {
      "matchPackageNames": ["prisma", "@prisma/client"],
      "allowedVersions": "<7"
    },
    {
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    },
    {
      "matchPackageNames": ["nodemailer"],
      "allowedVersions": "<8"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Node 24 ships npm 11; don't move the packageManager field past it",
      "matchPackageNames": ["npm"],
      "allowedVersions": "<12"
    },
    {
      "description": "@playwright/test must match the browsers in the Playwright Docker image (CI and docker-compose.e2e.yml), so update them together. New browser versions may need `npm run test:e2e:update`.",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright",
      "rangeStrategy": "pin"
    },
    {
      "description": "The Playwright image lands on MCR after the npm release, and MCR tags have no release timestamp Renovate can rely on, so minimumReleaseAge held it out of the group and the npm bump shipped alone. Skip the age check for the image; the @playwright/test age check still gates the group.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "minimumReleaseAge": null
    }
  ]
}
